<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="capacita.fintrackintermediario.Controller.NovaTransacaoController"
      spacing="20"
      alignment="CENTER">

    <Label text="NOVA TRANSAÇÃO"/>

    <Label fx:id="lblValidacao"
            text=""/>

    <GridPane hgap="10" vgap="10">

        <Label text="Descrição:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtDescricao"
                   promptText="Ex: Salário"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>


        <Label text="Valor:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtValor"
                   promptText="Ex: 1500.00"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>


        <Label text="Tipo:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="comboTipo"
                  GridPane.rowIndex="2"
                  GridPane.columnIndex="1"/>


        <Label text="Data:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <DatePicker fx:id="dateData"
                    GridPane.rowIndex="3"
                    GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="10">

        <Button text="Salvar"
                onAction="#salvarTransacao"/>

        <Button text="Cancelar"
                onAction="#cancelar"/>

    </HBox>

</VBox>